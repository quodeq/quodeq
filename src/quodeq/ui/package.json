{
  "name": "quodeq-ui-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test 'src/**/*.test.js' 'tools/**/*.test.mjs'",
    "test:ui": "vitest run",
    "test:all": "npm run test && npm run test:ui",
    "build": "vite build",
    "preview": "vite preview",
    "lint:strings": "node tools/check_strings.mjs",
    "lint:strings:update": "node tools/check_strings.mjs --update",
    "lint:size": "eslint --no-inline-config -c eslint.size.config.js src && node tools/check_size_grandfather.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "d3-hierarchy": "^3.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.102.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "^30.0.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
