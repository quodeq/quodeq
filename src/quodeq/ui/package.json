{
  "name": "quodeq-ui-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test 'src/**/*.test.js' 'tools/**/*.test.mjs'",
    "test:ui": "vitest run",
    "test:all": "npm run test && npm run test:ui",
    "build": "vite build",
    "preview": "vite preview",
    "lint:strings": "node tools/check_strings.mjs",
    "lint:strings:update": "node tools/check_strings.mjs --update",
    "lint:size": "eslint --no-inline-config -c eslint.size.config.js src && node tools/check_size_grandfather.mjs",
    "lint:hygiene": "node tools/check_hygiene.mjs",
    "lint:hygiene:update": "node tools/check_hygiene.mjs --update",
    "lint:magic": "node tools/check_magic.mjs",
    "lint:magic:update": "node tools/check_magic.mjs --update",
    "lint:vocab": "node tools/check_vocab.mjs",
    "lint:vocab:update": "node tools/check_vocab.mjs --update",
    "lint:a11y": "node tools/check_a11y.mjs",
    "lint:a11y:update": "node tools/check_a11y.mjs --update",
    "lint:clones": "node tools/check_clones.mjs",
    "lint:clones:update": "node tools/check_clones.mjs --update",
    "lint:fault": "node tools/check_fault.mjs",
    "lint:fault:update": "node tools/check_fault.mjs --update"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "d3-hierarchy": "^3.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.5.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "jscpd": "4.3.0",
    "jsdom": "^30.0.1",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
